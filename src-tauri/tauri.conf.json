{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petrichor",
  "version": "0.1.0",
  "identifier": "org.petrichor.petrichor",
  "build": {
    "frontendDist": "../dist/petrichor/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Petrichor",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Personnalisation du bureau Linux par skins",
    "longDescription": "Petrichor affiche des skins composés de mesures et de meters sur le bureau Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
